APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_NAME="MediaPitch Store"
APP_KEY=change-this-to-a-long-random-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mediapitch_store
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Editorial datetime-local fields are interpreted in this timezone and stored as UTC.
CONTENT_TIMEZONE=Asia/Kolkata

SESSION_NAME=mediapitch_session
SESSION_SECURE_COOKIE=false
SESSION_IDLE_TIMEOUT=3600
LOGIN_ATTEMPT_WINDOW=600
LOGIN_ATTEMPT_LIMIT=5
LOGIN_BLOCK_SECONDS=900
PASSWORD_RESET_TTL=3600
MAIL_TRANSPORT=mail
MAIL_FROM=admin@mediapitch.in

# BOOTSTRAP_ADMIN_PASSWORD is used to CREATE the configured administrator when
# the account does not yet exist. Existing administrator credentials are
# preserved during normal deployments. Set BOOTSTRAP_ADMIN_SYNC_EXISTING=true
# only for an intentional credential recovery/reset, then turn it off again.
BOOTSTRAP_ADMIN_NAME="MediaPitch Admin"
BOOTSTRAP_ADMIN_EMAIL=admin@mediapitch.in
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_SYNC_EXISTING=false

# CMS Admin API. Use a random key of at least 24 characters; 64 hex chars is recommended.
# Authorization: Bearer <CMS_API_KEY> or X-API-Key: <CMS_API_KEY>.
CMS_API_KEY=
CMS_API_AUTHOR_ID=0
# Query-string keys are useful for clients that cannot set headers (including simple GET tools),
# but can appear in access logs. Enable only with a dedicated, revocable API key.
CMS_API_ALLOW_QUERY_KEY=false
# GET writes are disabled by default. When enabled, every GET write requires request_id.
CMS_API_ALLOW_GET_WRITES=false

ANALYTICS_RETENTION_DAYS=395
AUDIT_RETENTION_DAYS=730
AFFILIATE_ANALYTICS_EXCLUDE_IPS=
AFFILIATE_ANALYTICS_EXCLUDE_UA=

MEDIA_MAX_UPLOAD_MB=5
MEDIA_MAX_DIMENSION=2000
MEDIA_THUMB_WIDTH=480
MEDIA_JPEG_QUALITY=84
MEDIA_WEBP_QUALITY=84
MEDIA_PNG_COMPRESSION=6

AMAZON_API_ENABLED=false
AMAZON_MARKETPLACE=www.amazon.in
AMAZON_PARTNER_TAG=
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_CREDENTIAL_VERSION=
AMAZON_API_RETRY_ATTEMPTS=3
AMAZON_AUTH_RETRY_ATTEMPTS=2
AMAZON_RETRY_BASE_MS=350
