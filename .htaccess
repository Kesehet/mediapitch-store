Options -Indexes
RewriteEngine On

# Serve public files when the hosting document root points at the repository root.
RewriteRule ^assets/(.*)$ public/assets/$1 [L]
RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]
RewriteRule ^robots\.txt$ public/robots.txt [L]
RewriteRule ^sitemap\.xml$ public/sitemap.php [QSA,L]

# Protect repository/application internals and secrets from direct web access.
RewriteRule ^(?:src|database|views|docs|vendor|\.git|\.github)(?:/|$) - [F,L]
<FilesMatch "^(?:\.env|\.env\..*|\.editorconfig|TASKS\.md|README\.md|composer\.json|composer\.lock)$">
    Require all denied
</FilesMatch>

# Route all application requests through the public front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ public/index.php [QSA,L]
