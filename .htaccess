Options -Indexes
RewriteEngine On

# Serve public assets when the hosting document root points at the repository root.
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

# Protect application internals and secrets from direct web access.
RewriteRule ^(?:src|database|views)/ - [F,L]
<FilesMatch "^(?:\.env|\.env\..*|TASKS\.md|README\.md)$">
    Require all denied
</FilesMatch>

# Route all application requests through the public front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ public/index.php [QSA,L]
